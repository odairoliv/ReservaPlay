### ReservaPlay — requisições de exemplo
### Use com a extensão "REST Client" do VS Code (ou copie para Postman/Insomnia).
### Antes: python manage.py popular_dados

@base = http://127.0.0.1:8000/api

### Raiz da API (links gerados pelo DefaultRouter)
GET {{base}}/

########################################################
# MODALIDADES
########################################################

### Listar
GET {{base}}/modalidades/

### Criar
POST {{base}}/modalidades/
Content-Type: application/json

{ "nome": "Handebol", "descricao": "Esporte coletivo jogado com as mãos." }

########################################################
# ESPAÇOS
########################################################

### Listar (paginado)
GET {{base}}/espacos/

### Filtros, busca e ordenação
GET {{base}}/espacos/?tipo=QUADRA&coberto=false&preco_max=100&ordering=-preco_hora

### Espaços de uma modalidade (N:N)
GET {{base}}/espacos/?modalidade=1

### Busca textual
GET {{base}}/espacos/?search=areia

### Detalhe (modalidades e reservas aninhadas) — 200
GET {{base}}/espacos/1/

### Detalhe inexistente — 404
GET {{base}}/espacos/9999/

### Criar — 201
POST {{base}}/espacos/
Content-Type: application/json

{
  "nome": "Ginásio Municipal",
  "tipo": "GINASIO",
  "descricao": "Ginásio com arquibancada.",
  "capacidade": 40,
  "preco_hora": "180.00",
  "coberto": true,
  "horario_abertura": "07:00",
  "horario_fechamento": "22:00",
  "modalidade_ids": [1, 3, 4]
}

### Criar inválido — 400
POST {{base}}/espacos/
Content-Type: application/json

{ "nome": "", "capacidade": 0, "tipo": "ESTADIO" }

### Atualização completa (PUT) — 200
PUT {{base}}/espacos/1/
Content-Type: application/json

{
  "nome": "Quadra Poliesportiva Central",
  "tipo": "QUADRA",
  "descricao": "Quadra coberta reformada.",
  "capacidade": 24,
  "preco_hora": "95.00",
  "coberto": true,
  "ativo": true,
  "horario_abertura": "08:00",
  "horario_fechamento": "23:00",
  "modalidade_ids": [1, 3, 4]
}

### Atualização parcial (PATCH) — 200
PATCH {{base}}/espacos/1/
Content-Type: application/json

{ "preco_hora": "100.00" }

### Horários ocupados em um dia
GET {{base}}/espacos/1/disponibilidade/?data=2026-12-01

### Excluir espaço COM reservas — 400 (integridade referencial / PROTECT)
DELETE {{base}}/espacos/1/

########################################################
# RESERVAS
########################################################

### Listar (paginado)
GET {{base}}/reservas/

### Filtros: por espaço, status e período
GET {{base}}/reservas/?espaco=1&status=CONFIRMADA&data_inicio=2026-01-01&data_fim=2026-12-31

### Detalhe (espaço aninhado) — 200
GET {{base}}/reservas/1/

### Criar — 201 (valor_total calculado automaticamente)
POST {{base}}/reservas/
Content-Type: application/json

{
  "espaco_id": 1,
  "cliente_nome": "Lucas Ferreira",
  "cliente_email": "lucas@email.com",
  "cliente_telefone": "(11) 99999-0000",
  "data": "2026-12-01",
  "hora_inicio": "18:00",
  "hora_fim": "19:30",
  "observacoes": "Aniversário do time."
}

### Conflito de horário — 400 (repita a requisição acima)
POST {{base}}/reservas/
Content-Type: application/json

{
  "espaco_id": 1,
  "cliente_nome": "Outro Cliente",
  "cliente_email": "outro@email.com",
  "data": "2026-12-01",
  "hora_inicio": "19:00",
  "hora_fim": "20:00"
}

### Horário de término antes do início — 400
POST {{base}}/reservas/
Content-Type: application/json

{
  "espaco_id": 1,
  "cliente_nome": "Teste",
  "cliente_email": "teste@email.com",
  "data": "2026-12-01",
  "hora_inicio": "20:00",
  "hora_fim": "19:00"
}

### Espaço inexistente — 400
POST {{base}}/reservas/
Content-Type: application/json

{
  "espaco_id": 9999,
  "cliente_nome": "Teste",
  "cliente_email": "teste@email.com",
  "data": "2026-12-01",
  "hora_inicio": "10:00",
  "hora_fim": "11:00"
}

### Atualização completa (PUT) — 200
PUT {{base}}/reservas/1/
Content-Type: application/json

{
  "espaco_id": 1,
  "cliente_nome": "Carlos Silva",
  "cliente_email": "carlos@email.com",
  "cliente_telefone": "(11) 98888-7777",
  "data": "2026-12-05",
  "hora_inicio": "19:00",
  "hora_fim": "21:00",
  "status": "CONFIRMADA",
  "observacoes": ""
}

### Atualização parcial (PATCH) — 200
PATCH {{base}}/reservas/1/
Content-Type: application/json

{ "status": "CONFIRMADA" }

### Cancelar reserva
POST {{base}}/reservas/2/cancelar/

### Excluir — 204
DELETE {{base}}/reservas/1/

### Excluído — 404
GET {{base}}/reservas/1/
