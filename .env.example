# Copie este arquivo para .env e ajuste os valores.
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados: sqlite (padrão) ou mysql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Usado apenas quando DB_ENGINE=mysql (requer: pip install mysqlclient)
# DB_NAME=reservaplay
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
